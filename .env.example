# Public demo credentials for a local development lab only.
# Never use these passwords for an exposed or production deployment.
# CDC role/topic/database names are also referenced by the SQL and connector files.

POSTGRES_DB=fruits_db
POSTGRES_USER=fruits_admin
POSTGRES_PASSWORD=wasd
POSTGRES_PORT=5432

GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations
GOOSE_DBSTRING=postgres://fruits_admin:wasd@127.0.0.1:5432/fruits_db?sslmode=disable
GOOSE_DBSTRING_DOCKER=postgres://fruits_admin:wasd@db:5432/fruits_db?sslmode=disable

TEST_POSTGRES_DB=fruits_test_db
TEST_GOOSE_DBSTRING_DOCKER=postgres://fruits_admin:wasd@db:5432/fruits_test_db?sslmode=disable

APP_ENV=dev
MIGRATION_VERSION=
RUN_SEQWALL=false
SEED_COUNT=2000
WORKLOAD_PORT=8080

METRICS_DB_USER=metrics_user
METRICS_DB_PASSWORD=metrics_password

DEBEZIUM_DB_USER=fruits_debezium
DEBEZIUM_DB_PASSWORD=debezium_password
DEBEZIUM_CONNECTOR_NAME=postgres-connector
DEBEZIUM_TOPIC_PREFIX=fruits
DEBEZIUM_SLOT_NAME=fruits_order_event_log_slot
DEBEZIUM_PUBLICATION_NAME=fruits_order_event_log_publication
DEBEZIUM_TABLE_INCLUDE_LIST=public.order_event_log

CLICKHOUSE_DB=fruits_bi
CLICKHOUSE_METABASE_USER=metabase_ch
CLICKHOUSE_METABASE_PASSWORD=metabase_ch_password
CLICKHOUSE_CDC_TOPIC=fruits.public.order_event_log
CLICKHOUSE_CDC_GROUP=fruits_clickhouse_order_event_log_cdc

METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase_password

GRAFANA_ADMIN_USER=grafadmin
GRAFANA_ADMIN_PASSWORD=adminpwd

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BACKUP_ACCESS_KEY=backup-writer
MINIO_BACKUP_SECRET_KEY=backup-writer-secret
MINIO_RESTORE_ACCESS_KEY=backup-reader
MINIO_RESTORE_SECRET_KEY=backup-reader-secret

BUCKET_BACKUP_NAME=fruits-backups
BACKUP_INTERVAL=*/30 * * * *
BACKUP_RETENTION_COUNT=5


PATRONI_SCOPE=fruits-postgres
PATRONI_NAMESPACE=/service/example
PATRONI_SUPERUSER_USERNAME=postgres
PATRONI_SUPERUSER_PASSWORD=local_superuser_demo
PATRONI_REPLICATION_USERNAME=replicator
PATRONI_REPLICATION_PASSWORD=local_replication_demo
PATRONI_REWIND_USERNAME=rewind_user
PATRONI_REWIND_PASSWORD=local_rewind_demo
