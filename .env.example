POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5432

GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations
GOOSE_DBSTRING=postgres://your_db_user:your_db_password@127.0.0.1:5432/your_db_name?sslmode=disable
GOOSE_DBSTRING_DOCKER=postgres://your_db_user:your_db_password@db:5432/your_db_name?sslmode=disable

TEST_POSTGRES_DB=your_test_db_name
TEST_GOOSE_DBSTRING_DOCKER=postgres://your_db_user:your_db_password@db:5432/your_test_db_name?sslmode=disable

APP_ENV=dev
MIGRATION_VERSION=
RUN_SEQWALL=false
SEED_COUNT=2000
WORKLOAD_PORT=8080

METRICS_DB_USER=metrics_user
METRICS_DB_PASSWORD=metrics_password

GRAFANA_ADMIN_USER=grafadmin
GRAFANA_ADMIN_PASSWORD=adminpwd

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BACKUP_ACCESS_KEY=backup-writer
MINIO_BACKUP_SECRET_KEY=backup-writer-secret
MINIO_RESTORE_ACCESS_KEY=backup-reader
MINIO_RESTORE_SECRET_KEY=backup-reader-secret

BUCKET_BACKUP_NAME=fruits-backups
BACKUP_INTERVAL=*/30 * * * *
BACKUP_RETENTION_COUNT=5


PATRONI_SCOPE=fruits-postgres-example
PATRONI_NAMESPACE=/service/example
PATRONI_SUPERUSER_USERNAME=postgres-example
PATRONI_SUPERUSER_PASSWORD=your_patroni_superuser_password_example
PATRONI_REPLICATION_USERNAME=replicator-example
PATRONI_REPLICATION_PASSWORD=your_replication_password_example
PATRONI_REWIND_USERNAME=rewind_user_example
PATRONI_REWIND_PASSWORD=your_rewind_password_example
